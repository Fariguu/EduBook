# ==============================================================================
# EduBook - Environment Variables Template
# ==============================================================================
# Duplica questo file in .env.local e inserisci i valori specifici del tuo ambiente.
# Esempio: cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. Supabase Backend (Auth, Database Postgres, Storage)
# ------------------------------------------------------------------------------
# URL del progetto Supabase (trovabile in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Chiave anonima pubblica per client-side (safe per browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Chiave di servizio con privilegi elevati (Bypass RLS, SOLO per Server Actions / admin client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Cloudflare Turnstile (Protezione Anti-Bot e Anti-Spam)
# ------------------------------------------------------------------------------
# Chiavi di test ufficiali Cloudflare (passano sempre automaticamente per sviluppo locale):
# Site Key test: 1x00000000000000000000AA
# Secret Key test: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ------------------------------------------------------------------------------
# 3. Resend (Email Transazionali di Conferma, Rifiuto e Spostamento)
# ------------------------------------------------------------------------------
# API Key generata nella dashboard di Resend (https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Email mittente autorizzata (in ambiente di test puoi usare on-boarding@resend.dev)
# RESEND_FROM_EMAIL="EduBook <lezioni@tuodominio.it>"

# Email del docente per ricevere notifiche di nuovi messaggi di contatto
# PROFESSOR_NOTIFICATION_EMAIL=info@tuodominio.it

# ------------------------------------------------------------------------------
# 4. Configurazione Applicazione & Sicurezza
# ------------------------------------------------------------------------------
# URL base dell'applicazione per generazione link assoluti (Google Calendar, gestione prenotazione)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Token di sicurezza per autorizzare l'endpoint cron di manutenzione (/api/cron/cleanup)
# Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-secure-random-cron-secret
